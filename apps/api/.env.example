# API environment. Copy to `.env` and fill in — `.env` is gitignored.
# Every key here is validated by src/platform/env.ts at boot; an invalid value
# stops the process with a message naming the key, rather than failing later.

# development | test | production
NODE_ENV=development

# Port to bind. Must parse as an integer 1-65535.
PORT=8080

# Bind address. 0.0.0.0 in containers; 127.0.0.1 to keep it host-local.
HOST=0.0.0.0

# REQUIRED — no default. Atlas: mongodb+srv://<user>:<pass>@<cluster>/<db>
# Use the ap-south-1 (Mumbai) region: spec §6.8 requires Indian data residency.
MONGODB_URI=mongodb://localhost:27017/bya

# Comma-separated CORS allowlist. Must contain at least one origin.
# 5173 = the Vite SPA, 3000 = the Next.js marketing site.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# AUTH — first-party phone OTP + JWT
# ---------------------------------------------------------------------------
# REQUIRED — no default, min 32 chars. Signs and verifies every access token
# (HS256). A defaulted or shared secret would let anyone mint sessions.
# Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# DEV ONLY. Echo the OTP in the /v1/auth/otp/request response so local
# development needs no MSG91 credentials (the SMS attempt then logs a
# `skipped` delivery row). Boot REFUSES this under NODE_ENV=production.
AUTH_DEV_ECHO_OTP=true

# Optional OTP tuning. Defaults shown; see src/constants/auth.constants.ts.
# OTP_TTL_SEC=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SEC=30

# ---------------------------------------------------------------------------
# KYC ENCRYPTION (spec §6.5)
# ---------------------------------------------------------------------------
# Base64 32-byte master key wrapping the per-value data keys. Generate with:
#   openssl rand -base64 32
#
# Optional: the API boots without it, but any endpoint touching PAN or bank
# details then fails loudly rather than storing plaintext. There is deliberately
# no fallback to unencrypted storage.
#
# DEVELOPMENT ONLY. Production replaces localKms with a cloud KMS, which is what
# gives key rotation and access audit without re-encrypting the database.
# KMS_MASTER_KEY=

# ---------------------------------------------------------------------------
# FILE STORAGE — AWS S3 (spec docs/specs/2026-07-25-s3-storage-slice.md)
# ---------------------------------------------------------------------------
# Defaulted, not optional — ap-south-1 (Mumbai) matches the DPDP residency
# requirement the rest of the stack already honors.
AWS_REGION=ap-south-1

# Optional, and the switch storage is selected on (app.ts): unset ⇒
# unavailableStorage() — every upload/download call fails loud with a 503
# rather than silently no-op'ing. Set this to enable real storage.
# S3_BUCKET=bya-uploads-dev

# Static credentials — DEV/LOCALSTACK ONLY, and meaningful only together (the
# adapter passes them to the SDK solely when both are set). On real AWS, omit
# both and attach an IAM role to the running instance/task instead — the AWS
# SDK's default provider chain then resolves credentials from the role, no
# keys in the environment at all.
# AWS_ACCESS_KEY_ID=dummy
# AWS_SECRET_ACCESS_KEY=dummy

# Set to point the S3 client at a local S3-compatible store instead of real
# AWS. http://127.0.0.1:4566 is LocalStack's default. Leave unset against
# real AWS — the SDK then addresses S3 directly.
# S3_ENDPOINT=http://127.0.0.1:4566

# ---------------------------------------------------------------------------
# NOTIFICATIONS — SMTP / WhatsApp / MSG91 (spec docs/specs/2026-07-25-notifications-slice.md)
# ---------------------------------------------------------------------------
# All optional. Each channel below is built only when its FULL set of keys is
# present (app.ts's buildNotificationSenders, from notification-adapters.ts).
# A partial set (e.g. SMTP_HOST with no SMTP_PASS) is treated the same as none
# — the channel is simply absent from the fan-out. With everything in this
# section left unset, every channel is skipped, and each attempt still writes
# a `skipped` row to the notifications delivery log rather than crashing.

# SMTP email — all three or none.
# SMTP_HOST=smtp.example.com
# SMTP_USER=apikey
# SMTP_PASS=dummy

# Meta WhatsApp Cloud API — both or none.
# WA_TOKEN=dummy
# WA_PHONE_ID=000000000000000

# MSG91 SMS (flow API) — all three or none. This is the PRIMARY channel for
# the sign-in OTP (`auth_otp` template): with these unset, OTP sends log
# `skipped` and local dev relies on AUTH_DEV_ECHO_OTP above instead.
# MSG91_AUTHKEY=dummy
# MSG91_TEMPLATE=000000000000000000000000
# MSG91_SENDER=BYADEV

# ---------------------------------------------------------------------------
# PAYMENTS — Razorpay (spec docs/specs/2026-07-25-payments-slice.md)
# ---------------------------------------------------------------------------
# All optional, and each gates a different thing (app.ts / the webhook route):
# the gateway itself (razorpayGateway, platform/payments.ts) is selected over
# unavailablePaymentGateway() — every createOrder/fetchOrder call 503s — only
# once BOTH key id and key secret below are set. The webhook secret is
# separate: it is what POST /v1/payments/webhook (P3) verifies the
# x-razorpay-signature header against, so the gateway can be configured while
# the webhook stays unavailable, or vice versa. Dummy creds for now — real
# values arrive later via Secrets Manager, never committed here.

# RAZORPAY_KEY_ID=rzp_test_dummy
# RAZORPAY_KEY_SECRET=dummy

# Used only by the webhook route (P3) to verify inbound Razorpay webhook
# deliveries — a separate secret from the key pair above, generated in the
# Razorpay dashboard when a webhook endpoint is registered.
# RAZORPAY_WEBHOOK_SECRET=dummy
