# SPA environment. Copy to `.env.local` (gitignored) and adjust.
# The API base. Defaults to http://localhost:8080 if unset.
# Auth (OTP request/verify, refresh, logout) is served by the same API —
# in dev the OTP request response includes `devOtp` so no SMS is needed.
VITE_API_BASE_URL=http://localhost:8080
